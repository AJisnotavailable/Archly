{
  "name": "archly-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/server & npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:desktop": "tauri dev",
    "tauri": "tauri",
    "build": "npm run build --workspaces",
    "build:server:bin": "bun build --compile apps/server/dist/server.js --outfile src-tauri/bin/archly-server.exe",
    "build:desktop": "tauri build --debug",
    "package:desktop": "tauri build",
    "start": "npm run start --workspace=apps/server"
  },
  "keywords": [
    "archly",
    "archly-github",
    "archly-architecture",
    "ai",
    "project-planner",
    "architecture-compiler",
    "c4-model",
    "mermaid-diagrams",
    "tauri",
    "system-design"
  ],
  "author": "AJisnotavailable",
  "repository": {
    "type": "git",
    "url": "https://github.com/AJisnotavailable/Archly.git"
  },
  "homepage": "https://ajisnotavailable.github.io/Archly",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
